@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-2">
        <span class="text-light me-2">Olá, @User.Identity?.Name!</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm">Sair</button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Account" asp-action="Register" class="register-link me-2 text-light">Cadastro</a>
        <a asp-controller="Account" asp-action="Login" class="login-link btn btn-primary btn-sm">Entrar</a>
    </div>
}